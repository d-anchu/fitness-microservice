# ============================================
# DOCKERIGNORE FOR REACT FRONTEND
# ============================================
# Excludes files from Docker build context

# Dependencies (will be installed via npm ci)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output (will be built in Docker)
dist/
build/

# Environment files (secrets should not be in image)
.env
.env.local
.env.*.local

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Git files
.git/
.gitignore

# OS files
.DS_Store
Thumbs.db

# Test files
coverage/
.nyc_output/

# Documentation
README.md
*.md

# CI/CD files
.github/
